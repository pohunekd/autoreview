# deploy/install.sh installs this file as /etc/systemd/system/autoreview-queue.service.
# autoreview-queue.timer starts it; it has the sandbox of autoreview.service.
[Unit]
Description=autoreview review queue notice
Documentation=https://github.com/pohunekd/autoreview/blob/main/docs/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=autoreview
Group=autoreview
ExecStart=/usr/local/bin/autoreview --config /etc/autoreview/config.yaml \
    --env-file /etc/autoreview/autoreview.env review-queue
StateDirectory=autoreview
StateDirectoryMode=0700
RuntimeDirectory=autoreview
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/autoreview /run/autoreview
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
