# deploy/install.sh installs this file as /etc/systemd/system/autoreview.service.
# The secrets reach the service only through --env-file: the file is owned by
# the autoreview user with mode 0600, and its values never enter the environment.
[Unit]
Description=autoreview pull request review service
Documentation=https://github.com/pohunekd/autoreview/blob/main/docs/install.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=autoreview
Group=autoreview
ExecStart=/usr/local/bin/autoreview --config /etc/autoreview/config.yaml \
    --env-file /etc/autoreview/autoreview.env serve
Restart=on-failure
RestartSec=10
StateDirectory=autoreview
StateDirectoryMode=0700
# Shared with autoreview-queue.service: preserved, so the hourly oneshot cannot
# remove /run/autoreview while serve runs.
RuntimeDirectory=autoreview
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
# The service writes only its state and runtime directories.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/autoreview /run/autoreview
PrivateTmp=yes
PrivateDevices=yes
# autoreview, gh and pohunek need no capability, no kernel or clock access and
# no namespaces; they speak HTTPS and Unix sockets only.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# EPERM instead of a kill: a refused call fails as an error that the logs name.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
