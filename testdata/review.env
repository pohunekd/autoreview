HERMES_PR_REVIEW_SESSION_GROUP=autoreview
HERMES_PR_REVIEW_AI_SIGNATURE=Written by AI: example review
HERMES_PR_REVIEW_MATRIX_MENTION_USER=@example-user:example.org
