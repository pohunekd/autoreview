# Synthetic service environment used by the tests; every secret is a placeholder
# added by the test itself.
HERMES_PR_REVIEW_GITHUB_HOST=github.com
HERMES_PR_REVIEW_GITHUB_LOGIN=example-user
HERMES_PR_REVIEW_GH_BIN=/usr/bin/gh
HERMES_PR_REVIEW_POHUNEK_BIN=/usr/local/bin/pohunek
HERMES_PR_REVIEW_POHUNEK_STATE_HOME=/var/lib/autoreview/pohunek
HERMES_PR_REVIEW_POHUNEK_RUNTIME_DIR=/run/autoreview/pohunek
HERMES_PR_REVIEW_POHUNEK_HOSTS_JSON=["local"]
