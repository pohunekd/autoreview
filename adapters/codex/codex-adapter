class InputFrameError(ValueError):
    """Raised when a Pohunek initial-input frame is absent or malformed."""


class HeadUnavailableError(InputFrameError):
    """Raised when the trusted pull request head is not in the review checkout."""


class RepositorySkillsError(InputFrameError):
    """Raised when a head checkout holds skills for Codex that the trusted base does not."""


def read_exact(stream: BinaryIO, size: int) -> bytes:
    data = bytearray()
    while len(data) < size:
        chunk = stream.read(size - len(data))
        if not chunk:
            raise InputFrameError("initial input ended unexpectedly")
        data.extend(chunk)
    return bytes(data)


def read_framed_prompt(stream: BinaryIO, maximum_bytes: int) -> str:
    if read_exact(stream, len(BRACKETED_PASTE_START)) != BRACKETED_PASTE_START:
        raise InputFrameError("initial input is missing the bracketed-paste start marker")

    payload = bytearray()
    while not payload.endswith(BRACKETED_PASTE_END):
        payload.extend(read_exact(stream, 1))
        if len(payload) > maximum_bytes + len(BRACKETED_PASTE_END):
            raise InputFrameError("initial input exceeds the configured byte limit")

    del payload[-len(BRACKETED_PASTE_END) :]
    if read_exact(stream, len(SUBMIT)) != SUBMIT:
        raise InputFrameError("initial input is missing the submit marker")
    if not payload:
        raise InputFrameError("initial input must not be empty")
    try:
        return payload.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise InputFrameError("initial input is not valid UTF-8") from error


def validate_executable(path: str) -> None:
    if not os.path.isabs(path):
        raise InputFrameError("Codex executable must be an absolute path")
    try:
        mode = os.stat(path).st_mode
    except OSError as error:
        raise InputFrameError("Codex executable is unavailable") from error
    if not stat.S_ISREG(mode) or not os.access(path, os.X_OK):
        raise InputFrameError("Codex executable is not an executable regular file")


def secure_regular_file(path: str) -> None:
    metadata = os.lstat(path)
    if not stat.S_ISREG(metadata.st_mode):
        raise InputFrameError("Codex path file must be a regular file")
    if metadata.st_uid != os.geteuid():
        raise InputFrameError("Codex path file must be owned by the current user")
    if metadata.st_mode & 0o022:
        raise InputFrameError("Codex path file must not be group or world writable")


def sidecar_path() -> str:
    return os.path.realpath(__file__) + SIDECAR_SUFFIX


def read_codex_binary(sidecar: str) -> str:
    try:
        secure_regular_file(sidecar)
        with open(sidecar, encoding="utf-8") as stream:
            content = stream.read()
    except FileNotFoundError as error:
        raise InputFrameError(f"Codex path file {sidecar} is missing") from error
    except (OSError, UnicodeDecodeError) as error:
        raise InputFrameError(f"Codex path file {sidecar} is unreadable") from error
    path = content.removesuffix("\n")
    if not path or "\n" in path:
        raise InputFrameError(f"Codex path file {sidecar} must hold one path")
    validate_executable(path)
    return path


def codex_environment(environment: dict[str, str]) -> dict[str, str]:
    return {
        name: value
        for name, value in environment.items()
        if name not in DROPPED_ENVIRONMENT
        and not name.startswith(DROPPED_ENVIRONMENT_PREFIX)
    }


def fail(message: str) -> NoReturn:
    print(f"{PROGRAM_NAME}: {message}", file=sys.stderr)
    raise SystemExit(EXIT_USAGE)


def exit_after_retention(
    exit_status: int, retention_seconds: int, markers: Markers, marker: str = ""
) -> NoReturn:
    """Prints the exit line of `markers` that ends the output, then keeps it readable.

    A `marker` line goes into the same write, on the line right before the exit line.
    """
    marker_line = f"\n{marker}" if marker else ""
    print(f"{marker_line}\n{markers.exit_line_format.format(exit_status)}", flush=True)
    time.sleep(retention_seconds)
    raise SystemExit(exit_status)


def refuse(
    error: InputFrameError, retention_seconds: int, after_run: bool, markers: Markers
) -> NoReturn:
    """Ends a run whose request, checkout or result the adapter refuses, with the exit line."""
    print(f"{PROGRAM_NAME}: {error}", file=sys.stderr, flush=True)
    exit_after_retention(
        EXIT_USAGE, retention_seconds, markers, refusal_marker(error, after_run, markers)
    )


def refusal_marker(error: InputFrameError, after_run: bool, markers: Markers) -> str:
    """Returns the lines a refusal prints right before its exit line; empty for none.

    After the Codex run, the message that `refuse` prints goes on a reason line, as Codex's
    error line does. The head marker stays last, right before the exit line.
    """
    lines = []
    if after_run:
        lines.append(reason_marker(f"{PROGRAM_NAME}: {error}".encode("utf-8"), markers))
    if isinstance(error, HeadUnavailableError):
        lines.append(markers.refusal_format.format(REFUSAL_HEAD_UNAVAILABLE))
    if isinstance(error, RepositorySkillsError):
        lines.append(markers.refusal_format.format(REFUSAL_REPOSITORY_SKILLS))
    return "\n".join(lines)


def is_neutralized(character: str) -> bool:
    """Reports whether a reason shows `character` as `?`: see `NEUTRALIZED_CATEGORIES`."""
    return unicodedata.category(character) in NEUTRALIZED_CATEGORIES


def exit_reason(stderr: bytes) -> str:
    """Returns the line of Codex's `stderr` that names why the run failed, bounded and neutralized.

    The last line that starts with one of `ERROR_LINE_PREFIXES` wins, else the last line that
    is not blank, else the reason is empty. The first `REASON_MAX_BYTES` bytes of the line are
    decoded, invalid bytes as U+FFFD, and neutralized; the text is then cut to
    `REASON_MAX_BYTES` UTF-8 bytes at a character boundary.
    """
    lines = [line.strip() for line in stderr.split(b"\n")]
    lines = [line for line in lines if line]
    errors = [line for line in lines if line.startswith(ERROR_LINE_PREFIXES)]
    chosen = (errors or lines or [b""])[-1]
    text = chosen[:REASON_MAX_BYTES].decode("utf-8", errors="replace")
    neutralized = "".join("?" if is_neutralized(character) else character for character in text)
    # The text holds no surrogates, so "ignore" drops only a character that the cut split.
    return neutralized.encode("utf-8")[:REASON_MAX_BYTES].decode("utf-8", errors="ignore")


def reason_marker(stderr: bytes, markers: Markers) -> str:
    """Returns the marker line that carries the reason of a failed run to the engine."""
    reason = exit_reason(stderr).encode("utf-8")
    return markers.reason_format.format(base64.b64encode(reason).decode("ascii"))


def write_prompt(stream: BinaryIO, prompt: bytes) -> None:
    """Writes `prompt` to Codex's stdin and closes it; a Codex that exited ends the write."""
    with contextlib.suppress(BrokenPipeError):
        stream.write(prompt)
    with contextlib.suppress(BrokenPipeError):
        stream.close()


class StderrTail:
    """The end of Codex's stderr, which goes on to the adapter's stderr as it arrives."""

    def __init__(self) -> None:
        self.data = bytearray()
        self.truncated = False
        self.stopped = False
        self.lock = threading.Lock()

    def copy(self, stream: BinaryIO) -> None:
        """Copies `stream` to stderr until its end or `stop`, keeping the last bytes."""
        while chunk := os.read(stream.fileno(), STDERR_TAIL_BYTES):
            with self.lock:
                if self.stopped:
                    return
                sys.stderr.buffer.write(chunk)
                sys.stderr.buffer.flush()
                self.data += chunk
                if len(self.data) > STDERR_TAIL_BYTES:
                    del self.data[:-STDERR_TAIL_BYTES]
                    self.truncated = True

    def stop(self) -> None:
        """Ends the copy: once it returns, nothing from the stream reaches the adapter's stderr."""
        with self.lock:
            self.stopped = True

    def lines(self) -> bytes:
        """Returns the kept bytes; a cut tail loses its first line, which is only an end."""
        data = bytes(self.data)
        if self.truncated:
            _, _, data = data.partition(b"\n")
        return data


def run_codex(
    arguments: list[str], prompt: bytes, environment: dict[str, str]
) -> tuple[int, bytes]:
    """Runs Codex; returns its status and the complete lines of the end of its stderr.

    Codex's stderr goes on to the session output as it arrives. Threads write the prompt
    and read stderr, so neither pipe can block the other, and the run ends when Codex exits.
    Before it returns, the processes that Codex left have ended and the copy of its stderr
    has stopped, so nothing that the run started writes after the adapter's markers.
    """
    process = subprocess.Popen(
        arguments, stdin=subprocess.PIPE, stderr=subprocess.PIPE, env=environment
    )
    tail = StderrTail()
    reader = threading.Thread(target=tail.copy, args=(process.stderr,), daemon=True)
    writer = threading.Thread(target=write_prompt, args=(process.stdin, prompt), daemon=True)
    reader.start()
    writer.start()
    status = process.wait()
    stop_leftover_processes()
    reader.join(STDERR_DRAIN_SECONDS)
    tail.stop()
    return status, tail.lines()


def become_subreaper() -> None:
    """Makes the adapter the reaper of its orphaned descendants, see `PR_SET_CHILD_SUBREAPER`."""
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_CHILD_SUBREAPER, ctypes.c_ulong(1), 0, 0, 0) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def child_processes() -> list[int]:
    """Returns the ids of the adapter's child processes, ended ones not yet reaped included."""
    parent = os.getpid()
    children = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            stat_line = Path("/proc", entry, "stat").read_text(encoding="utf-8", errors="replace")
        # A process gone since the listing, or another user's under `hidepid`, is no child
        # that the adapter can see; a hidden child of its own keeps the adapter in the wait.
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        # The name in parentheses may hold any character; the state and the parent process
        # id are the first two fields after its last `)`.
        if int(stat_line[stat_line.rindex(")") + 1 :].split()[1]) == parent:
            children.append(int(entry))
    return children


def signal_children(signal_number: int) -> None:
    """Sends `signal_number` to every child; an unreaped child keeps its id, so none is reused."""
    for child in child_processes():
        os.kill(child, signal_number)


def reap_children() -> bool:
    """Reaps every child that has ended; reports whether a child is still running."""
    while True:
        try:
            child, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return False
        if child == 0:
            return True


def stop_leftover_processes() -> None:
    """Ends every process that the Codex run left, once Codex has exited and been reaped.

    The adapter is their reaper, so each one is its child or below one. The children get
    SIGTERM and `LEFTOVER_GRACE_SECONDS` to end, then SIGKILL; the orphans of a killed child
    become the adapter's children and get SIGKILL in the next round, until no child is left.
    A process that SIGKILL cannot end keeps the adapter here, before any marker.
    """
    signal_children(signal.SIGTERM)
    deadline = time.monotonic() + LEFTOVER_GRACE_SECONDS
    while reap_children() and time.monotonic() < deadline:
        time.sleep(LEFTOVER_POLL_SECONDS)
    while True:
        signal_children(signal.SIGKILL)
        try:
            os.waitpid(-1, 0)
        except ChildProcessError:
            return
        reap_children()


def codex_arguments(
    codex_binary: str,
    model: str,
    reasoning_effort: str,
    schema_path: Path,
    result_path: Path,
) -> list[str]:
    return [
        codex_binary,
        "exec",
        "--model",
        model,
        "--config",
        f'model_reasoning_effort="{reasoning_effort}"',
        "--config",
        'approval_policy="never"',
        # Codex loads the checkout's `AGENTS.md` files as instructions unless the project is
        # marked untrusted; a zero byte budget reads none. The prompt names the trusted guidance.
        "--config",
        "project_doc_max_bytes=0",
        # This drops the catalog of the skills that Codex loads, which every turn lists. A skill
        # that the prompt names still loads, so the checkout check refuses a head's new skills.
        "--config",
        "skills.include_instructions=false",
        "--sandbox",
        "read-only",
        "--ignore-user-config",
        "--ignore-rules",
        "--ephemeral",
        "--color",
        "never",
        "--output-schema",
        str(schema_path),
        "--output-last-message",
        str(result_path),
        "-",
    ]


def trusted_head_sha(prompt: str) -> str:
    matches = TRUSTED_HEAD_PATTERN.findall(prompt)
    if len(matches) != 1:
        raise InputFrameError("trusted pull request head is missing or ambiguous")
    return matches[0]


def git_command(*arguments: str) -> list[str]:
    """Returns git `arguments` without optional locks, so `git status` leaves the index alone."""
    return ["git", "--no-optional-locks", *arguments]


def checkout_head_sha(cwd: Path | None = None) -> str:
    completed = subprocess.run(
        git_command("rev-parse", "--verify", "HEAD^{commit}"),
        capture_output=True,
        text=True,
        check=False,
        cwd=cwd,
    )
    head = completed.stdout.strip()
    if completed.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", head):
        raise InputFrameError("review checkout HEAD is unavailable")
    return head


def verify_checkout_clean(cwd: Path | None = None) -> None:
    status = subprocess.run(
        git_command(
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
            "--ignore-submodules=none",
        ),
        capture_output=True,
        text=True,
        errors="surrogateescape",
        check=False,
        cwd=cwd,
    )
    if status.returncode != 0:
        raise InputFrameError("review checkout status is unavailable")
    if status.stdout:
        raise InputFrameError("review checkout is not clean")


def trusted_base_sha(prompt: str) -> str:
    matches = TRUSTED_BASE_PATTERN.findall(prompt)
    if len(matches) != 1:
        raise InputFrameError("trusted pull request base is missing or ambiguous")
    return matches[0]


def nonce_markers(nonce: str) -> Markers:
    """Returns the markers of `PROTOCOL_V2`, each bound to the request's `nonce`."""
    opening = f"[{PROTOCOL_V2} {nonce} "
    return Markers(
        result_prefix=opening + "result:",
        exit_line_format=opening + "exited with status {}]",
        refusal_format=opening + "refused:{}]",
        reason_format=opening + "reason:{}]",
    )


def result_markers(prompt: str) -> tuple[Markers, str]:
    """Returns the markers that the trusted protocol line names, and the prompt for Codex.

    A prompt without the line comes from an older engine, which reads only the legacy markers.
    Under `PROTOCOL_V2` the one nonce line binds the markers to the request; it is removed
    from the prompt, so the model never reads the nonce.
    """
    protocols = TRUSTED_PROTOCOL_PATTERN.findall(prompt)
    nonces = TRUSTED_NONCE_PATTERN.findall(prompt)
    if protocols == [PROTOCOL_V2]:
        if len(nonces) != 1 or not NONCE_PATTERN.fullmatch(nonces[0]):
            raise InputFrameError("trusted nonce is missing, ambiguous or invalid")
        nonce_line = NONCE_LINE_PREFIX + nonces[0]
        lines = [line for line in prompt.split("\n") if line != nonce_line]
        return nonce_markers(nonces[0]), "\n".join(lines)
    if nonces:
        raise InputFrameError(f"trusted nonce is valid only with {PROTOCOL_V2}")
    if not protocols:
        return LEGACY_MARKERS, prompt
    if protocols != [PROTOCOL]:
        raise InputFrameError("trusted protocol is ambiguous or unknown")
    return MARKERS, prompt


def trusted_checkout(prompt: str) -> str:
    """Returns the checkout the engine started the worktree from, `base` or `head`."""
    matches = TRUSTED_CHECKOUT_PATTERN.findall(prompt)
    # A prompt without a checkout line gets the strict head check.
    if not matches:
        return CHECKOUT_HEAD
    if len(matches) != 1 or matches[0] not in (CHECKOUT_BASE, CHECKOUT_HEAD):
        raise InputFrameError("trusted review checkout is ambiguous or invalid")
    return matches[0]


def commit_available(sha: str, cwd: Path | None = None) -> bool:
    available = subprocess.run(
        git_command("cat-file", "-e", sha + "^{commit}"),
        capture_output=True,
        check=False,
        cwd=cwd,
    )
    return available.returncode == 0


def is_ancestor(ancestor: str, descendant: str, cwd: Path | None = None) -> bool:
    """Reports whether `ancestor` is `descendant` or one of its ancestors."""
    checked = subprocess.run(
        git_command("merge-base", "--is-ancestor", ancestor, descendant),
        capture_output=True,
        check=False,
        cwd=cwd,
    )
    if checked.returncode not in (0, 1):
        raise InputFrameError("review checkout history is unavailable")
    return checked.returncode == 0


def verify_checkout_head(prompt: str, cwd: Path | None = None) -> str:
    expected_head_sha = trusted_head_sha(prompt)
    if checkout_head_sha(cwd) != expected_head_sha:
        raise InputFrameError(
            "review checkout HEAD does not match the trusted pull request head"
        )
    verify_checkout_clean(cwd)
    if not commit_available(trusted_base_sha(prompt), cwd):
        raise InputFrameError("trusted pull request base is unavailable in the review checkout")
    return expected_head_sha


def git_entries(arguments: list[str], cwd: Path | None = None) -> list[str]:
    """Returns the NUL-separated entries that a git listing prints."""
    listed = subprocess.run(git_command(*arguments), capture_output=True, check=False, cwd=cwd)
    if listed.returncode != 0:
        raise InputFrameError("review checkout skills are unavailable")
    entries = listed.stdout.split(b"\0")
    return [entry.decode("utf-8", errors="surrogateescape") for entry in entries if entry]


def skill_levels(cwd: Path | None = None) -> tuple[Path, list[str]]:
    """Returns the checkout root and the directories from it to `cwd`, as root-relative prefixes."""
    shown = subprocess.run(
        git_command("rev-parse", "--show-prefix"), capture_output=True, check=False, cwd=cwd
    )
    if shown.returncode != 0:
        raise InputFrameError("review checkout directory is unavailable")
    prefix = shown.stdout.removesuffix(b"\n").decode("utf-8", errors="surrogateescape")
    parts = [part for part in prefix.split("/") if part]
    # Git computes the prefix on the real path, so the root is the resolved `cwd` without it.
    root = (Path.cwd() if cwd is None else cwd).resolve()
    for part in reversed(parts):
        if root.name != part:
            raise InputFrameError("review checkout directory is unavailable")
        root = root.parent
    return root, ["".join(part + "/" for part in parts[:count]) for count in range(len(parts) + 1)]


def base_skill_entries(
    base_sha: str, levels: list[str], cwd: Path | None = None
) -> dict[str, tuple[str, str, str]]:
    """Returns the mode, object and size of each path below `.agents` and `.codex` in the base."""
    pathspecs = [
        f":(top,literal){level}{parent}" for level in levels for parent in SKILL_PARENT_FOLDERS
    ]
    entries = {}
    listing = ["ls-tree", "-r", "-l", "-z", "--full-tree", base_sha, "--", *pathspecs]
    for entry in git_entries(listing, cwd):
        fields, _, path = entry.partition("\t")
        details = fields.split()
        if len(details) != 4 or not path:
            raise InputFrameError("review checkout skills are unavailable")
        entries[path] = (details[0], details[2], details[3])
    return entries


def open_without_links(name: str, flags: int) -> int:
    return os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK)


def skill_file_matches(path: Path, expected: tuple[str, str, str] | None) -> bool:
    """Reports whether the file at `path` has the mode, size and content of its base entry."""
    if expected is None:
        return False
    base_mode, base_object, base_size = expected
    try:
        with open(path, "rb", opener=open_without_links) as handle:
            status = os.fstat(handle.fileno())
            executable = status.st_mode & stat.S_IXUSR
            mode = EXECUTABLE_FILE_MODE if executable else REGULAR_FILE_MODE
            if not stat.S_ISREG(status.st_mode) or (mode, str(status.st_size)) != (
                base_mode, base_size
            ):
                return False
            content = handle.read(status.st_size + 1)
    except OSError as error:
        raise InputFrameError("review checkout skills are unavailable") from error
    # Objects are SHA-1 ones: the trusted base SHA has 40 hex characters.
    blob = hashlib.sha1(b"blob %d\0" % len(content) + content).hexdigest()
    return len(content) == status.st_size and blob == base_object


def verify_repository_skills(prompt: str, cwd: Path | None = None) -> None:
    """Refuses a clean head checkout whose skill folders on disk differ from the trusted base.

    Codex reads the disk, which index flags, ignore rules and nested repositories hide from
    git, so every entry there must be a folder or a file of the base, with its mode and content;
    a base path that the disk lacks passes. Of `.agents` and `.codex`, only `skills` loads.
    """
    root, levels = skill_levels(cwd)
    entries = base_skill_entries(trusted_base_sha(prompt), levels, cwd)
    folders = {
        path.rsplit("/", depth)[0] for path in entries for depth in range(1, path.count("/") + 1)
    }
    pending = [(f"{level}{parent}", True) for level in levels for parent in SKILL_PARENT_FOLDERS]
    listed = 0
    while pending:
        path, is_parent = pending.pop()
        try:
            mode = os.lstat(root / path).st_mode
        except FileNotFoundError:
            continue
        except OSError as error:
            raise InputFrameError("review checkout skills are unavailable") from error
        if stat.S_ISREG(mode):
            matches = skill_file_matches(root / path, entries.get(path))
        else:
            matches = stat.S_ISDIR(mode) and (is_parent or path in folders)
        if not matches:
            raise RepositorySkillsError(
                "review checkout adds or changes repository skills that Codex would load"
            )
        if not stat.S_ISDIR(mode):
            continue
        if is_parent:
            # A `.git` there is a nested repository, which is never a base path.
            pending += [(f"{path}/skills", False), (f"{path}/.git", False)]
            continue
        try:
            with os.scandir(root / path) as children:
                for child in children:
                    listed += 1
                    if listed > SKILL_ENTRIES_MAX:
                        raise InputFrameError("review checkout skills are unavailable")
                    pending.append((f"{path}/{child.name}", False))
        except OSError as error:
            raise InputFrameError("review checkout skills are unavailable") from error


def verify_base_checkout(prompt: str, cwd: Path | None = None) -> str:
    """Checks a base checkout and returns its HEAD; it reads only the local repository.

    Pohunek starts the worktree at the fetched base branch tip, which is the trusted base or
    a descendant of it unless the base branch was rewritten.
    """
    expected_head_sha = trusted_head_sha(prompt)
    base_sha = trusted_base_sha(prompt)
    checkout_sha = checkout_head_sha(cwd)
    verify_checkout_clean(cwd)
    if not commit_available(base_sha, cwd):
        raise InputFrameError("trusted pull request base is unavailable in the review checkout")
    # Pohunek 0.43.0 or later fetches the head at session start, an older one only the base
    # branch; Codex reads the head through git and cannot fetch.
    if not commit_available(expected_head_sha, cwd):
        raise HeadUnavailableError(
            "trusted pull request head is unavailable in the review checkout"
        )
    if is_ancestor(expected_head_sha, checkout_sha, cwd):
        raise InputFrameError("review checkout HEAD is the pull request head or contains it")
    if not is_ancestor(base_sha, checkout_sha, cwd):
        raise InputFrameError(
            "review checkout HEAD does not descend from the trusted pull request base"
        )
    return checkout_sha


def verify_review_checkout(prompt: str, cwd: Path | None = None) -> tuple[str, str]:
    """Checks the checkout before the run; returns the trusted head and the checkout HEAD."""
    if trusted_checkout(prompt) == CHECKOUT_BASE:
        return trusted_head_sha(prompt), verify_base_checkout(prompt, cwd)
    head_sha = verify_checkout_head(prompt, cwd)
    verify_repository_skills(prompt, cwd)
    return head_sha, head_sha


def verify_review_checkout_after_run(
    prompt: str, checkout_sha: str, cwd: Path | None = None
) -> None:
    """Repeats the checkout check after the run and requires the HEAD it recorded."""
    if trusted_checkout(prompt) == CHECKOUT_HEAD:
        verify_checkout_head(prompt, cwd)
        return
    if verify_base_checkout(prompt, cwd) != checkout_sha:
        raise InputFrameError("review checkout HEAD changed during the review")


def validate_blocking_and_prior_findings(value: dict) -> None:
    """Checks the two fields that the Claude result carries as well."""
    findings = value.get("findings")
    if not isinstance(findings, list):
        raise InputFrameError("Codex review result has no findings list")
    if not all(
        isinstance(finding, dict) and isinstance(finding.get("blocking"), bool)
        for finding in findings
    ):
        raise InputFrameError("Codex review result has a finding without a blocking flag")
    prior_findings = value.get("prior_findings")
    if not isinstance(prior_findings, list) or not all(
        isinstance(verdict, dict)
        and set(verdict) == PRIOR_VERDICT_KEYS
        and isinstance(verdict["key"], str)
        and verdict["key"]
        and verdict["status"] in PRIOR_STATUSES
        and isinstance(verdict["note"], str)
        and verdict["note"]
        and isinstance(verdict["relies_on"], str)
        for verdict in prior_findings
    ):
        raise InputFrameError("Codex review result has invalid prior findings")


def encoded_result(path: Path, maximum_bytes: int, expected_head_sha: str) -> str:
    try:
        data = path.read_bytes()
    except OSError as error:
        raise InputFrameError("Codex did not produce a review result") from error
    if not data or len(data) > maximum_bytes:
        raise InputFrameError("Codex review result has an invalid size")
    try:
        value = json.loads(data.decode("utf-8", errors="strict"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise InputFrameError("Codex review result is not valid JSON") from error
    if not isinstance(value, dict):
        raise InputFrameError("Codex review result must be an object")
    if value.get("status") != "completed" or value.get("reviewed_head_sha") != expected_head_sha:
        raise InputFrameError("Codex did not complete a review of the trusted pull request head")
    validate_blocking_and_prior_findings(value)
    compact = json.dumps(
        value, ensure_ascii=False, separators=(",", ":"), sort_keys=True
    ).encode("utf-8")
    if len(compact) > maximum_bytes:
        raise InputFrameError("Codex review result exceeds the configured byte limit")
    return base64.b64encode(compact).decode("ascii")


def exec_version_probe() -> NoReturn:
    try:
        codex_binary = read_codex_binary(sidecar_path())
    except InputFrameError as error:
        fail(str(error))
    # The probe gets the environment of a review run, so it sees no dropped variable.
    os.execve(codex_binary, [codex_binary, "--version"], codex_environment(dict(os.environ)))


def main() -> NoReturn:
    # Pohunek's runtime version probe runs the profile program with a bare
    # --version and without the profile args, so answer it for Codex.
    if sys.argv[1:] == ["--version"]:
        exec_version_probe()
    profile_arguments = sys.argv[1:]
    if (
        len(profile_arguments) == PROFILE_ARGUMENT_COUNT + 1
        and profile_arguments[-1] == NO_DAEMON_ARGUMENT
    ):
        profile_arguments = profile_arguments[:-1]
    if (
        len(profile_arguments) != PROFILE_ARGUMENT_COUNT
        or NO_DAEMON_ARGUMENT in profile_arguments
    ):
        fail(
            "expected Codex executable, maximum input size, maximum result size, "
            "maximum retention time, model, and reasoning effort, optionally "
            f"followed by {NO_DAEMON_ARGUMENT}"
        )
    (
        codex_binary,
        maximum_bytes_text,
        maximum_result_bytes_text,
        maximum_retention_seconds_text,
        model,
        reasoning_effort,
    ) = profile_arguments
    try:
        maximum_bytes = int(maximum_bytes_text)
        maximum_result_bytes = int(maximum_result_bytes_text)
        maximum_retention_seconds = int(maximum_retention_seconds_text)
    except ValueError:
        fail("maximum sizes and retention time must be integers")
    if (
        maximum_bytes <= 0
        or maximum_result_bytes <= 0
        or maximum_retention_seconds <= 0
    ):
        fail("maximum sizes and retention time must be positive")
    if reasoning_effort not in REASONING_EFFORTS:
        fail("reasoning effort is invalid")
    try:
        configured_binary = read_codex_binary(sidecar_path())
    except InputFrameError as error:
        fail(str(error))
    if codex_binary != configured_binary:
        fail("Codex executable argument differs from the Codex path file")
    if not sys.stdin.isatty():
        fail("stdin must be a Pohunek-managed PTY")
    try:
        become_subreaper()
    # A C library without `prctl`, as on systems other than Linux, raises AttributeError.
    except (OSError, AttributeError) as error:
        fail(f"needs Linux PR_SET_CHILD_SUBREAPER to end Codex's leftover processes: {error}")

    descriptor = sys.stdin.fileno()
    original_attributes = termios.tcgetattr(descriptor)
    try:
        # Raw mode comes before the title: pohunek writes the frame once it sees the title,
        # and the TCSAFLUSH of setraw discards input that arrived before the switch.
        tty.setraw(descriptor)
        sys.stdout.buffer.write(READY_TITLE)
        sys.stdout.buffer.flush()
        prompt = read_framed_prompt(sys.stdin.buffer, maximum_bytes)
    except InputFrameError as error:
        fail(str(error))
    finally:
        termios.tcsetattr(descriptor, termios.TCSANOW, original_attributes)

    try:
        markers, prompt = result_markers(prompt)
    except InputFrameError as error:
        refuse(error, maximum_retention_seconds, after_run=False, markers=LEGACY_MARKERS)
    try:
        expected_head_sha, checkout_sha = verify_review_checkout(prompt)
    except InputFrameError as error:
        refuse(error, maximum_retention_seconds, after_run=False, markers=markers)

    with tempfile.TemporaryDirectory(prefix="codex-adapter-") as directory:
        temporary_directory = Path(directory)
        os.chmod(temporary_directory, 0o700)
        schema_path = temporary_directory / "schema.json"
        result_path = temporary_directory / "result.json"
        schema_path.write_text(
            json.dumps(RESULT_SCHEMA, separators=(",", ":"), sort_keys=True),
            encoding="utf-8",
        )
        os.chmod(schema_path, 0o600)
        status, stderr_tail = run_codex(
            codex_arguments(
                codex_binary,
                model,
                reasoning_effort,
                schema_path,
                result_path,
            ),
            prompt.encode("utf-8"),
            codex_environment(dict(os.environ)),
        )
        if status != 0:
            exit_after_retention(
                status, maximum_retention_seconds, markers, reason_marker(stderr_tail, markers)
            )
        try:
            verify_review_checkout_after_run(prompt, checkout_sha)
            result = encoded_result(result_path, maximum_result_bytes, expected_head_sha)
        except InputFrameError as error:
            refuse(error, maximum_retention_seconds, after_run=True, markers=markers)
        print(f"\n{markers.result_prefix}{result}]", flush=True)
        exit_after_retention(0, maximum_retention_seconds, markers)


if __name__ == "__main__":
    main()
