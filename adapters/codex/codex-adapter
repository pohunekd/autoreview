class Markers(NamedTuple):
    """The marker lines of one name of the result protocol."""

    result_prefix: str
    exit_line_format: str
    refusal_format: str
    reason_format: str


BRACKETED_PASTE_START = b"\x1b[200~"
BRACKETED_PASTE_END = b"\x1b[201~"
SUBMIT = b"\r"
EXIT_USAGE = 64
PROGRAM_NAME = "codex-adapter"
# The engine reads the result frame and the exit line by these exact texts. Right before
# the exit line with status 64, the refusal marker names the reason of a refusal that the
# engine does not retry. Right before the exit line of a failed Codex run, the reason marker
# holds the base64 of the reason that `exit_reason` takes from Codex's stderr; empty when
# stderr has no line. A refusal after the run puts the adapter's own message there, before
# any head marker. Under `autoreview-codex/v2` every marker carries the request's nonce,
# which the model never sees, so a marker that the transcript prints cannot pass for one.
PROTOCOL_V2 = "autoreview-codex/v2"
# An older engine sends this name and reads these markers, which carry no nonce.
PROTOCOL = "autoreview-codex/v1"
MARKERS = Markers(
    result_prefix="[autoreview-codex/v1 result:",
    exit_line_format="[autoreview-codex/v1 exited with status {}]",
    refusal_format="[autoreview-codex/v1 refused:{}]",
    reason_format="[autoreview-codex/v1 reason:{}]",
)
# An older engine reads only these markers, and its prompt has no trusted protocol line.
LEGACY_MARKERS = Markers(
    result_prefix="[pohunek-codex-review-result-v1:",
    exit_line_format="[pohunek-codex-review exited with status {}]",
    refusal_format="[pohunek-codex-review-refused-v1:{}]",
    reason_format="[pohunek-codex-review-reason-v1:{}]",
