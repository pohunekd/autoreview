REFUSAL_HEAD_UNAVAILABLE = "head_unavailable"
REFUSAL_REPOSITORY_SKILLS = "repository_skills"
# Codex 0.167.0 loads the skills in `.agents/skills` and `.codex/skills` of every directory
# from the project root to its working directory, without host trust, through folder links.
SKILL_PARENT_FOLDERS = (".agents", ".codex")
# Git's modes of a file and of an executable file, which the skills check compares with the base.
REGULAR_FILE_MODE = "100644"
EXECUTABLE_FILE_MODE = "100755"
# Most UTF-8 bytes of a reason, as the engine's bound; a longer one is cut at a character.
REASON_MAX_BYTES = 512
# Codex prints a failed turn as `ERROR: ...`; its argument parser prints `error: ...`.
ERROR_LINE_PREFIXES = (b"ERROR:", b"error:")
# Most bytes of Codex's stderr that the adapter keeps to find the reason in. Not a tunable:
# it bounds the adapter's own memory, and no operator decision depends on it.
STDERR_TAIL_BYTES = 65536
# Most entries that the skills check lists in the skill folders of a head checkout before it
# refuses. Not a tunable: it bounds a walk of folders that head code can fill, and no operator
# decision depends on it.
SKILL_ENTRIES_MAX = 10000
# Longest wait for the end of Codex's stderr after Codex and the processes it left ended:
# a process outside the adapter's tree that got the pipe may keep it open, and the exit
# line must not wait for it. Not a tunable: it bounds the wait for such a process, and no
# operator decision depends on it.
STDERR_DRAIN_SECONDS = 5
# The Linux `prctl` option that makes the adapter the reaper of its orphaned descendants,
# so a process that Codex leaves stays its child after a double fork or `setsid`.
PR_SET_CHILD_SUBREAPER = 36
# Time that the processes Codex left get after SIGTERM, before SIGKILL, and the step of the
# check whether they ended. Not tunables: they bound the end of a run, and no operator
# decision depends on them.
LEFTOVER_GRACE_SECONDS = 2
LEFTOVER_POLL_SECONDS = 0.05
# Unicode general categories that a reason shows as `?`: controls, format characters such
# as bidi controls, soft hyphens and tags, and the line and paragraph separators, which
# could make a log line read differently than it is.
NEUTRALIZED_CATEGORIES = ("Cc", "Cf", "Zl", "Zp")
