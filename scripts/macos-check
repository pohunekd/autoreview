#!/bin/sh
# Checks an autoreview release archive for Apple Silicon on a Mac before it is used, or
# the launchd agents that scripts/setup installed.
#
# usage: scripts/macos-check archive [--no-attestation] <archive>
#        scripts/macos-check service
#        scripts/macos-check log-block < config.yaml
#
# <archive> is <dir>/autoreview-<version>-aarch64-apple-darwin.tar.gz, and its .sha256 file
# must be next to it. Each check prints `ok`, `skip` or `FAIL`, and the
# first FAIL exits 1: the platform, the .sha256 line, the build provenance attestation of the
# release workflow for the tag v<version>, the quarantine attribute, the archive members, the
# ad-hoc signature and identifier of the binary, its libraries and `autoreview --version`.
# --no-attestation skips only the attestation, for the artifact of a dry run, which has none.
# The archive is extracted into a temporary directory; nothing else is written. POSIX sh, so
# Apple's /bin/sh runs it; it needs gh only for the attestation.
#
# `service` reads the two agents and changes nothing: both files pass plutil -lint and hold
# no other variables than AGENT_VARIABLES (secrets only through --env-file), both are loaded
# in the login domain, the review agent runs its binary, the queue agent has its 13 hours,
# the secrets file is mode 0600 and the launchd log is private. It names the pohunek daemon
# socket that the agent dials, checks it against pohunek.runtime_dir of config.yaml, and runs
# `autoreview validate` once in the agent's environment. When config.yaml holds the `log:`
# block that scripts/setup writes, it also checks that the review agent's log file exists and
# that neither log file is larger than max_file_bytes plus one line.
#
# `log-block` reads a config.yaml on stdin and prints the directory, max_file_bytes and
# kept_files of its top-level `log:` block, one per line. It exits 3 (LOG_BLOCK_REFUSED) and
# prints nothing unless the block is the three lines `  directory: V`, `  max_file_bytes: N`,
# `  kept_files: N`; V is plain or double-quoted, with `\\` and `\"` as its only escapes. A
# failure of the reader itself is a FAIL with exit 1, never a refusal.

set -eu

REPOSITORY=pohunekd/autoreview
WORKFLOW=pohunekd/autoreview/.github/workflows/release.yml
IDENTIFIER=io.github.pohunekd.autoreview
TARGET=aarch64-apple-darwin
# The oldest macOS release that the archive is built for (MACOSX_DEPLOYMENT_TARGET).
MACOS_MIN_MAJOR=14
# The labels of the agents of scripts/setup, and the only variables it writes into them.
AGENT_LABEL=io.github.pohunekd.autoreview
QUEUE_LABEL=io.github.pohunekd.autoreview-queue
AGENT_VARIABLES="PATH XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR"
# The queue agent runs at 08:00 to 20:00, one entry per hour.
QUEUE_ENTRIES=13
# The files that `serve` and `review-queue` write in log.directory.
SERVE_LOG_FILE=autoreview.log
QUEUE_LOG_FILE=autoreview-queue.log
# Room for the one line that may take a log file past max_file_bytes; more means a rotation failed.
LOG_LINE_ALLOWANCE=65536
# The exit status of `log-block` for a block that is not the three lines of scripts/setup.
LOG_BLOCK_REFUSED=3

ok() {
    printf 'ok    %s\n' "$*"
}

fail() {
    printf 'FAIL  %s\n' "$*" >&2
    exit 1
}

check_platform() {
    [ "$(uname -sm)" = "Darwin arm64" ] || fail "platform: $(uname -sm), not Darwin arm64"
    macos=$(sw_vers -productVersion) || fail "sw_vers -productVersion"
    [ "${macos%%.*}" -ge "$MACOS_MIN_MAJOR" ] \
        || fail "macOS $macos is older than $MACOS_MIN_MAJOR"
    ok "platform Darwin arm64, macOS $macos"
}

# Prints the value at key path $2 of plist $1; fails when it has none.
plist_value() {
    plutil -extract "$2" raw -o - "$1" 2>/dev/null
}

# Prints the EnvironmentVariables names of plist $1, one per line.
plist_variables() {
    variables=$(plutil -extract EnvironmentVariables xml1 -o - "$1") \
        || fail "plutil -extract EnvironmentVariables $1"
    printf '%s\n' "$variables" | sed -n 's|.*<key>\(.*\)</key>.*|\1|p'
}

# Prints the permission bits of path $1 in octal without leading zeros, then a space and
# the owner uid. BSD %Lp is not padded, so %03Lp pads it: mode 1022 reads 1022, not 122.
mode_owner() {
    line=$(stat -f '%Mp%03Lp %u' "$1") || fail "stat $1"
    printf '%o %s\n' "$((0${line% *}))" "${line#* }"
}

# Reads a config.yaml on stdin and prints the directory, max_file_bytes and kept_files of its
# top-level log: block, one per line. Returns LOG_BLOCK_REFUSED, printing nothing, unless the
# three lines after `log:` are the ones scripts/setup writes; a sed error is a FAIL.
read_log_block() {
    block=$(sed -n '/^log:[[:space:]]*$/{n;p;n;p;n;p;}') || fail "sed of the log: block"
    directory=$(printf '%s\n' "$block" | sed -n '1s/^  directory: *\(.*\)$/\1/p') \
        || fail "sed of the log directory"
    max_bytes=$(printf '%s\n' "$block" | sed -n '2s/^  max_file_bytes: *\([0-9][0-9]*\)$/\1/p') \
        || fail "sed of max_file_bytes"
    kept=$(printf '%s\n' "$block" | sed -n '3s/^  kept_files: *\([0-9][0-9]*\)$/\1/p') \
        || fail "sed of kept_files"
    if [ -z "$directory" ] || [ -z "$max_bytes" ] || [ -z "$kept" ]; then
        return "$LOG_BLOCK_REFUSED"
    fi
    case $directory in
        \"*\")
            directory=${directory#\"}
            directory=${directory%\"}
            # Only the escapes that scripts/setup writes; any other backslash is refused.
            rest=$(printf '%s\n' "$directory" | sed 's/\\[\\"]//g') \
                || fail "sed of the log directory"
            case $rest in
                *\\*) return "$LOG_BLOCK_REFUSED" ;;
            esac
            directory=$(printf '%s\n' "$directory" | sed 's/\\\(.\)/\1/g') \
                || fail "sed of the log directory"
            ;;
        *\ \#*) return "$LOG_BLOCK_REFUSED" ;;
    esac
    case $directory in
        /*) ;;
        *) return "$LOG_BLOCK_REFUSED" ;;
    esac
    printf '%s\n%s\n%s\n' "$directory" "$max_bytes" "$kept"
}

# Checks the log files in log.directory of config $1: the review agent's file exists, and
# neither file is larger than max_file_bytes plus LOG_LINE_ALLOWANCE. The queue file exists
# only after the first hourly run. A config without the block that setup writes is skipped.
check_log_files() {
    reader=0
    values=$(read_log_block <"$1") || reader=$?
    case $reader in
        0) ;;
        "$LOG_BLOCK_REFUSED")
            printf 'skip  log files (%s has no log: block of the %s)\n' "$1" \
                "three lines scripts/setup writes"
            return
            ;;
        *) fail "reading the log: block of $1 ended with status $reader" ;;
    esac
    log_directory=$(printf '%s\n' "$values" | sed -n 1p)
    log_limit=$(printf '%s\n' "$values" | sed -n 2p)
    for name in "$SERVE_LOG_FILE" "$QUEUE_LOG_FILE"; do
        file=$log_directory/$name
        if [ ! -f "$file" ]; then
            [ "$name" = "$QUEUE_LOG_FILE" ] || fail "missing the log $file; log.directory of $1"
            printf 'skip  %s (the queue agent writes it at its first run)\n' "$file"
            continue
        fi
        size=$(stat -f %z "$file") || fail "stat $file"
        [ "$size" -le $((log_limit + LOG_LINE_ALLOWANCE)) ] \
            || fail "$file is $size bytes, over max_file_bytes $log_limit of $1"
        ok "log file $file, $size of $log_limit bytes"
    done
}

check_service() {
    uid=$(id -u) || fail "id -u"
    domain=gui/$uid
    agents=$HOME/Library/LaunchAgents
    for label in "$AGENT_LABEL" "$QUEUE_LABEL"; do
        plist=$agents/$label.plist
        [ -f "$plist" ] || fail "missing $plist; run scripts/setup"
        plutil -lint -s "$plist" || fail "plutil -lint refused $plist"
        names=$(plist_variables "$plist")
        for key in $names; do
            case " $AGENT_VARIABLES " in
                *" $key "*) ;;
                *) fail "$label sets $key; setup passes secrets only through --env-file" ;;
            esac
        done
        [ "$(plist_value "$plist" ProgramArguments.3)" = --env-file ] \
            || fail "$label does not read --env-file"
        launchctl print "$domain/$label" >/dev/null 2>&1 \
            || fail "$domain/$label is not loaded; run scripts/setup"
    done
    ok "agents $AGENT_LABEL and $QUEUE_LABEL loaded, secrets only through --env-file"

    plist=$agents/$AGENT_LABEL.plist
    names=$(plist_variables "$plist")
    binary=$(plist_value "$plist" ProgramArguments.0) || fail "no program in $plist"
    config=$(plist_value "$plist" ProgramArguments.2) || fail "no --config in $plist"
    env_file=$(plist_value "$plist" ProgramArguments.4) || fail "no --env-file in $plist"
    status=$(launchctl print "$domain/$AGENT_LABEL") || fail "launchctl print $AGENT_LABEL"
    state=$(printf '%s\n' "$status" | sed -n 's/^[[:space:]]*state = //p' | head -n 1)
    pid=$(printf '%s\n' "$status" | sed -n 's/^[[:space:]]*pid = //p' | head -n 1)
    [ "$state" = running ] || fail "$AGENT_LABEL is ${state:-unknown}, not running; read its log"
    running=$(ps -o comm= -p "$pid") || fail "ps -p $pid"
    # `ps -o comm=` may name a symbolic link that launchd ran, so both sides are resolved.
    resolved=$(readlink -f "$running") || fail "readlink -f $running"
    target=$(readlink -f "$binary") || fail "readlink -f $binary"
    [ "$resolved" = "$target" ] || fail "pid $pid does not run $binary"
    ok "$AGENT_LABEL runs $binary as pid $pid"

    last=$((QUEUE_ENTRIES - 1))
    if ! plist_value "$agents/$QUEUE_LABEL.plist" "StartCalendarInterval.$last.Hour" >/dev/null \
        || plist_value "$agents/$QUEUE_LABEL.plist" "StartCalendarInterval.$QUEUE_ENTRIES" \
            >/dev/null; then
        fail "$QUEUE_LABEL does not hold exactly $QUEUE_ENTRIES calendar entries"
    fi
    ok "$QUEUE_LABEL runs at $QUEUE_ENTRIES hours"

    [ "$(mode_owner "$env_file")" = "600 $uid" ] || fail "$env_file must be yours with mode 0600"
    ok "secrets file $env_file, mode 0600"
    log=$(plist_value "$plist" StandardErrorPath) || fail "no log in $plist"
    [ -f "$log" ] || fail "missing the log $log"
    case $(mode_owner "$log") in
        *00\ *) ;;
        *) fail "$log is readable by other users" ;;
    esac
    ok "launchd log $log, private"
    check_log_files "$config"

    runtime=$(plist_value "$plist" EnvironmentVariables.XDG_RUNTIME_DIR) || runtime=""
    lines=$(sed -n 's/^  runtime_dir: *//p' "$config") || fail "reading $config"
    configured=$(printf '%s\n' "$lines" | head -n 1)
    configured=${configured#\"}
    configured=${configured%\"}
    [ "$configured" = "$runtime" ] \
        || fail "pohunek.runtime_dir of $config is '$configured', the agent has '$runtime'"
    if [ -n "$runtime" ]; then
        socket=$runtime/pohunek/daemon.sock
    else
        socket=/private/tmp/pohunek-$uid/daemon.sock
    fi
    if [ ! -S "$socket" ] || [ "$(stat -f %u "$socket")" != "$uid" ]; then
        fail "no pohunek daemon socket of yours at $socket"
    fi
    ok "pohunek daemon socket $socket"

    set -- HOME="$HOME"
    for key in $names; do
        value=$(plist_value "$plist" "EnvironmentVariables.$key") || fail "reading $key of $plist"
        set -- "$@" "$key=$value"
    done
    env -i "$@" "$binary" --config "$config" --env-file "$env_file" validate >/dev/null 2>&1 \
        || fail "autoreview validate in the agent's environment failed; run it there to see why"
    ok "autoreview validate in the agent's environment"
}

if [ "$#" -eq 1 ] && [ "$1" = service ]; then
    check_platform
    check_service
    exit 0
fi

if [ "$#" -eq 1 ] && [ "$1" = log-block ]; then
    read_log_block
    exit
fi

usage="usage: scripts/macos-check archive [--no-attestation] <archive> | service | log-block"
if [ "$#" -lt 2 ] || [ "$1" != archive ]; then
    fail "$usage"
fi
shift
attestation=yes
if [ "$1" = --no-attestation ]; then
    attestation=no
    shift
fi
[ "$#" -eq 1 ] || fail "$usage"
archive=$1
file=${archive##*/}
version=${file#autoreview-}
version=${version%-"$TARGET".tar.gz}
if ! printf '%s\n' "$version" | grep -Eqx '(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)' \
    || [ "$file" != "autoreview-$version-$TARGET.tar.gz" ]; then
    fail "not an archive name autoreview-<X.Y.Z>-$TARGET.tar.gz: $file"
fi
name="autoreview-$version-$TARGET"
if [ ! -f "$archive" ] || [ ! -f "$archive.sha256" ]; then
    fail "missing $archive or $archive.sha256"
fi

check_platform

sum=$(shasum -a 256 "$archive") || fail "shasum -a 256 $file"
digest=${sum%% *}
printf '%s\n' "$digest" | grep -Eqx '[0-9a-f]{64}' || fail "shasum gave no SHA-256 digest of $file"
[ "$(cat "$archive.sha256")" = "$digest  $file" ] || fail "$file.sha256 does not match the archive"
ok "sha256 $digest"

if [ "$attestation" = yes ]; then
    gh attestation verify "$archive" --repo "$REPOSITORY" --signer-workflow "$WORKFLOW" \
        --source-ref "refs/tags/v$version" --deny-self-hosted-runners >/dev/null \
        || fail "attestation of $file (signer $WORKFLOW, tag v$version)"
    ok "attestation of $WORKFLOW for refs/tags/v$version"
else
    printf 'skip  attestation (--no-attestation)\n'
fi

# curl and gh set no quarantine attribute; a browser does, and Gatekeeper then blocks the
# binary because it is not notarized.
if xattr -p com.apple.quarantine "$archive" >/dev/null 2>&1; then
    fail "$file has com.apple.quarantine; download it with curl -fLO or gh release download"
fi
ok "no quarantine attribute"

listing=$(tar -tzf "$archive") || fail "tar -tzf $file"
members=$(printf '%s\n' "$listing" | LC_ALL=C sort)
expected=$(printf '%s\n' "$name/" "$name/LICENSE" "$name/README.md" "$name/autoreview" \
    | LC_ALL=C sort)
[ "$members" = "$expected" ] \
    || fail "the archive holds other members than $name/ with LICENSE, README.md, autoreview"
ok "members"

work=$(mktemp -d "${TMPDIR:-/tmp}/macos-check.XXXXXX") || fail "mktemp -d"
trap 'rm -rf -- "$work"' EXIT
tar -xzf "$archive" -C "$work" || fail "tar -xzf $file"
binary=$work/$name/autoreview
# The member names alone allow links; a link would make the checks below read another file.
if [ -L "$work/$name" ] || [ ! -d "$work/$name" ] || [ -L "$binary" ] || [ ! -f "$binary" ]; then
    fail "$name/autoreview is not a regular file in a directory"
fi

codesign --verify --strict "$binary" 2>/dev/null || fail "codesign --verify --strict"
details=$(codesign -dv "$binary" 2>&1) || fail "codesign -dv"
printf '%s\n' "$details" | grep -qx 'Signature=adhoc' || fail "the signature is not ad-hoc"
printf '%s\n' "$details" | grep -qx "Identifier=$IDENTIFIER" \
    || fail "the identifier is not $IDENTIFIER"
ok "ad-hoc signature, identifier $IDENTIFIER"

# /usr/bin/otool exists without the command line tools too, as a stub that fails and offers to
# install them, so the tools are detected with xcode-select (xcrun could open that offer).
if xcode-select -p >/dev/null 2>&1; then
    linked=$(otool -L "$binary") || fail "otool -L"
    libraries=$(printf '%s\n' "$linked" | sed 1d | awk '{print $1}')
    printf '%s\n' "$libraries" | grep -qx /usr/lib/libSystem.B.dylib \
        || fail "otool -L lists no /usr/lib/libSystem.B.dylib"
    for library in $libraries; do
        case $library in
            /usr/lib/* | /System/Library/*) ;;
            *) fail "links $library, which is not a system library" ;;
        esac
    done
    ok "system libraries only"
else
    printf 'skip  libraries (the Xcode command line tools are not installed; %s)\n' \
        "the release build checks them"
fi

[ "$("$binary" --version)" = "autoreview $version" ] || fail "--version is not autoreview $version"
ok "autoreview --version: autoreview $version"
