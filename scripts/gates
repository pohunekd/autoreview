#!/usr/bin/env bash
# Runs the repository gates, reports each gate's own result and exits non-zero
# when any gate failed. Usage: scripts/gates [all|docs|adapters|rust]; CI runs
# the docs, adapters and rust groups as separate jobs.
set -uo pipefail
# Deliberately no -e: a failing gate must not stop the others from running.

cd "$(dirname "$0")/.." || exit 2

group=${1:-all}
case "$group" in
    all | docs | adapters | rust) ;;
    *)
        echo "usage: scripts/gates [all|docs|adapters|rust]" >&2
        exit 2
        ;;
esac

names=()
results=()
failed=0

run_gate() {
    local name=$1
    shift
    echo "==> $name: $*"
    local rc=0
    "$@" || rc=$?
    names+=("$name")
    if [ "$rc" -eq 0 ]; then
        results+=("passed")
    else
        results+=("failed (exit $rc)")
        failed=1
    fi
}

skip_gate() {
    echo "==> $1: skipped, $2"
    names+=("$1")
    results+=("skipped ($2)")
}

# CI sets CI, so there a missing shellcheck fails the gate instead of skipping it.
docs_gates() {
    run_gate check-docs python3 -I scripts/check-docs
    if command -v shellcheck >/dev/null 2>&1 || [ -n "${CI:-}" ]; then
        run_gate shellcheck shellcheck scripts/setup
    else
        skip_gate shellcheck "shellcheck is not on PATH"
    fi
    run_gate setup-self-test scripts/setup --self-test
}

# Every adapters/<name>/tests directory is a gate of its own, so a new adapter
# is picked up without a change here.
adapters_gates() {
    local tests found=0
    for tests in adapters/*/tests; do
        [ -d "$tests" ] || continue
        found=1
        run_gate "adapter-$(basename "$(dirname "$tests")")" \
            python3 -I -B -m unittest discover -s "$tests" -p 'test_*.py'
    done
    if [ "$found" -eq 0 ]; then
        skip_gate adapters "no adapters/*/tests directory"
    fi
}

rust_gates() {
    run_gate rust-fmt cargo fmt --all --check
    run_gate rust-clippy cargo clippy --workspace --all-targets --locked -- -D warnings
    run_gate rust-test cargo test --workspace --locked
    run_gate changelog scripts/changelog check
}

case "$group" in
    all)
        docs_gates
        adapters_gates
        rust_gates
        ;;
    docs) docs_gates ;;
    adapters) adapters_gates ;;
    rust) rust_gates ;;
esac

echo
echo "Gate results:"
for i in "${!names[@]}"; do
    echo "  ${names[$i]}: ${results[$i]}"
done
exit "$failed"
